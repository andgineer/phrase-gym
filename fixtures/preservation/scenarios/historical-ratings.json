{
  "description": "Historical journal payloads: the retired repair-deferral flag is rejected on current sessions without recording anything, an explicit false flag is part of the retained payload, and a queued rating from a historical session keeps its payload and receipt on identical retry, conflicts when the flag changes and schedules no in-session repair.",
  "implementations": [
    "python"
  ],
  "clock": "2026-10-12T12:00:00+00:00",
  "steps": [
    {
      "id": "reference-day",
      "request": {
        "method": "POST",
        "path": "/api/v1/media",
        "json": {
          "metadata": {
            "language": "en",
            "text": "How has your day been so far?",
            "role": "reference",
            "origin": "actor",
            "source": "preservation-fixture",
            "performer": "Synthetic test fixture",
            "locale": "en-US",
            "preparation_version": "1"
          },
          "mime_type": "audio/wav",
          "audio_base64": {
            "$base64": {
              "file": "fixtures/preservation/media/silence-100ms.wav"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "at": "/id",
            "equals": "622c73f6-c932-5b0a-95a0-fac4785a1bd0"
          }
        ]
      },
      "capture": {
        "media_day": "/id"
      }
    },
    {
      "id": "reference-catch-up",
      "request": {
        "method": "POST",
        "path": "/api/v1/media",
        "json": {
          "metadata": {
            "language": "en",
            "text": "Let’s catch up over coffee.",
            "role": "reference",
            "origin": "actor",
            "source": "preservation-fixture",
            "performer": "Synthetic test fixture",
            "locale": "en-US",
            "preparation_version": "1"
          },
          "mime_type": "audio/wav",
          "audio_base64": {
            "$base64": {
              "file": "fixtures/preservation/media/silence-100ms.wav"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "at": "/id",
            "equals": "5d5e93bc-5197-53cc-be83-0fc1d7441466"
          }
        ]
      },
      "capture": {
        "media_catch_up": "/id"
      }
    },
    {
      "id": "reference-rather",
      "request": {
        "method": "POST",
        "path": "/api/v1/media",
        "json": {
          "metadata": {
            "language": "en",
            "text": "I’d rather meet tomorrow.",
            "role": "reference",
            "origin": "actor",
            "source": "preservation-fixture",
            "performer": "Synthetic test fixture",
            "locale": "en-US",
            "preparation_version": "1"
          },
          "mime_type": "audio/wav",
          "audio_base64": {
            "$base64": {
              "file": "fixtures/preservation/media/silence-100ms.wav"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "at": "/id",
            "equals": "e3421577-fc46-5f46-8dca-3da71bd8e1f5"
          }
        ]
      },
      "capture": {
        "media_rather": "/id"
      }
    },
    {
      "id": "stage-content",
      "request": {
        "method": "POST",
        "path": "/api/v1/imports",
        "json": {
          "$json_file": "fixtures/preservation/packages/en-basic.json",
          "set": {
            "/targets/0/reference_audio_id": "{{media_day}}",
            "/targets/1/reference_audio_id": "{{media_catch_up}}",
            "/targets/2/reference_audio_id": "{{media_rather}}"
          }
        }
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "at": "/status",
            "equals": "staged"
          }
        ]
      },
      "capture": {
        "content_import": "/id"
      }
    },
    {
      "id": "publish-content",
      "request": {
        "method": "POST",
        "path": "/api/v1/imports/{{content_import}}/publish",
        "json": {
          "reviewed": true
        }
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "at": "/status",
            "equals": "published"
          }
        ]
      },
      "capture": {
        "target_day": "/changes/0/target_id",
        "target_catch_up": "/changes/1/target_id",
        "target_rather": "/changes/2/target_id"
      }
    },
    {
      "id": "start",
      "request": {
        "method": "POST",
        "path": "/api/v1/sessions",
        "json": {
          "id": "5e551011-0000-4000-8000-000000000201",
          "language": "en"
        }
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "at": "/status",
            "equals": "active"
          },
          {
            "at": "/queue",
            "length": 3
          },
          {
            "at": "/manifest/planner_version",
            "equals": "due-new-v3-online"
          }
        ]
      }
    },
    {
      "id": "retired-option-rejected-on-current-session",
      "request": {
        "method": "POST",
        "path": "/api/v1/sessions/5e551011-0000-4000-8000-000000000201/events",
        "json": {
          "events": [
            {
              "id": "000e7e47-0000-4000-8000-000002010001",
              "sequence": 1,
              "step": 0,
              "kind": "rate",
              "occurred_at": "2026-10-12T12:00:00+00:00",
              "rating": "not_yet",
              "defer_repairs": true
            }
          ]
        }
      },
      "expect": {
        "status": 422
      }
    },
    {
      "id": "rejection-records-nothing",
      "request": {
        "method": "GET",
        "path": "/api/v1/sessions/5e551011-0000-4000-8000-000000000201"
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "at": "/last_sequence",
            "equals": 0
          }
        ]
      }
    },
    {
      "id": "false-option-accepted",
      "request": {
        "method": "POST",
        "path": "/api/v1/sessions/5e551011-0000-4000-8000-000000000201/events",
        "json": {
          "events": [
            {
              "id": "000e7e47-0000-4000-8000-000002010001",
              "sequence": 1,
              "step": 0,
              "kind": "present",
              "occurred_at": "2026-10-12T12:00:00+00:00",
              "defer_repairs": false
            }
          ]
        }
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "at": "/receipts/0/sequence",
            "equals": 1
          }
        ]
      }
    },
    {
      "id": "false-option-retry",
      "request": {
        "method": "POST",
        "path": "/api/v1/sessions/5e551011-0000-4000-8000-000000000201/events",
        "json": {
          "events": [
            {
              "id": "000e7e47-0000-4000-8000-000002010001",
              "sequence": 1,
              "step": 0,
              "kind": "present",
              "occurred_at": "2026-10-12T12:00:00+00:00",
              "defer_repairs": false
            }
          ]
        }
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "at": "/receipts",
            "same_as": "false-option-accepted:/receipts"
          }
        ]
      }
    },
    {
      "id": "false-option-is-part-of-the-payload",
      "request": {
        "method": "POST",
        "path": "/api/v1/sessions/5e551011-0000-4000-8000-000000000201/events",
        "json": {
          "events": [
            {
              "id": "000e7e47-0000-4000-8000-000002010001",
              "sequence": 1,
              "step": 0,
              "kind": "present",
              "occurred_at": "2026-10-12T12:00:00+00:00"
            }
          ]
        }
      },
      "expect": {
        "status": 409
      }
    },
    {
      "id": "historical-queued-rating",
      "setup": {
        "sql": [
          "UPDATE practice_session SET manifest = json_set(manifest, '$.planner_version', 'due-new-v2') WHERE id = '5e551011-0000-4000-8000-000000000201';"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/api/v1/sessions/5e551011-0000-4000-8000-000000000201/events",
        "json": {
          "events": [
            {
              "id": "000e7e47-0000-4000-8000-000002010002",
              "sequence": 2,
              "step": 0,
              "kind": "rate",
              "occurred_at": "2026-10-12T12:00:00+00:00",
              "rating": "not_yet",
              "defer_repairs": true
            }
          ]
        }
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "at": "/receipts/0/sequence",
            "equals": 2
          },
          {
            "at": "/receipts/0/eligibility_reason",
            "equals": "eligible"
          },
          {
            "at": "/receipts/0/schedule_changed",
            "equals": true
          },
          {
            "at": "/session/manifest/planner_version",
            "equals": "due-new-v2"
          }
        ]
      }
    },
    {
      "id": "historical-queued-rating-retry",
      "request": {
        "method": "POST",
        "path": "/api/v1/sessions/5e551011-0000-4000-8000-000000000201/events",
        "json": {
          "events": [
            {
              "id": "000e7e47-0000-4000-8000-000002010002",
              "sequence": 2,
              "step": 0,
              "kind": "rate",
              "occurred_at": "2026-10-12T12:00:00+00:00",
              "rating": "not_yet",
              "defer_repairs": true
            }
          ]
        }
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "at": "/receipts",
            "same_as": "historical-queued-rating:/receipts"
          },
          {
            "at": "/session/last_sequence",
            "equals": 2
          },
          {
            "at": "/session/queue",
            "length": 3
          }
        ]
      }
    },
    {
      "id": "historical-queued-rating-changed-option",
      "request": {
        "method": "POST",
        "path": "/api/v1/sessions/5e551011-0000-4000-8000-000000000201/events",
        "json": {
          "events": [
            {
              "id": "000e7e47-0000-4000-8000-000002010002",
              "sequence": 2,
              "step": 0,
              "kind": "rate",
              "occurred_at": "2026-10-12T12:00:00+00:00",
              "rating": "not_yet",
              "defer_repairs": false
            }
          ]
        }
      },
      "expect": {
        "status": 409
      }
    },
    {
      "id": "second-card",
      "clock": "2026-10-12T12:03:00+00:00",
      "request": {
        "method": "POST",
        "path": "/api/v1/sessions/5e551011-0000-4000-8000-000000000201/events",
        "json": {
          "events": [
            {
              "id": "000e7e47-0000-4000-8000-000002010003",
              "sequence": 3,
              "step": 1,
              "kind": "present",
              "occurred_at": "2026-10-12T12:03:00+00:00"
            },
            {
              "id": "000e7e47-0000-4000-8000-000002010004",
              "sequence": 4,
              "step": 1,
              "kind": "rate",
              "occurred_at": "2026-10-12T12:03:00+00:00",
              "rating": "recalled"
            }
          ]
        }
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "at": "/session/queue",
            "length": 3
          }
        ]
      }
    },
    {
      "id": "historical-rating-schedules-no-repair",
      "clock": "2026-10-12T12:06:00+00:00",
      "request": {
        "method": "POST",
        "path": "/api/v1/sessions/5e551011-0000-4000-8000-000000000201/events",
        "json": {
          "events": [
            {
              "id": "000e7e47-0000-4000-8000-000002010005",
              "sequence": 5,
              "step": 2,
              "kind": "present",
              "occurred_at": "2026-10-12T12:06:00+00:00"
            },
            {
              "id": "000e7e47-0000-4000-8000-000002010006",
              "sequence": 6,
              "step": 2,
              "kind": "rate",
              "occurred_at": "2026-10-12T12:06:00+00:00",
              "rating": "recalled"
            }
          ]
        }
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "at": "/session/status",
            "equals": "completed"
          },
          {
            "at": "/session/queue",
            "length": 3
          }
        ]
      }
    }
  ]
}
