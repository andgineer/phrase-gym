{
  "components": {
    "schemas": {
      "CompleteStudy": {
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "maxLength": 100,
            "minLength": 8,
            "title": "Operation Id",
            "type": "string"
          }
        },
        "required": [
          "operation_id"
        ],
        "title": "CompleteStudy",
        "type": "object"
      },
      "Cue": {
        "additionalProperties": false,
        "properties": {
          "partner_line": {
            "anyOf": [
              {
                "maxLength": 300,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Partner Line"
          },
          "situation": {
            "maxLength": 500,
            "minLength": 5,
            "title": "Situation",
            "type": "string"
          }
        },
        "required": [
          "situation"
        ],
        "title": "Cue",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ImportCard": {
        "additionalProperties": false,
        "properties": {
          "accepted_variants": {
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "title": "Accepted Variants",
            "type": "array"
          },
          "answer": {
            "maxLength": 500,
            "minLength": 2,
            "title": "Answer",
            "type": "string"
          },
          "cues": {
            "items": {
              "$ref": "#/components/schemas/Cue"
            },
            "maxItems": 2,
            "minItems": 1,
            "title": "Cues",
            "type": "array"
          },
          "detailed_explanation": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detailed Explanation"
          },
          "explanation": {
            "maxLength": 1000,
            "minLength": 5,
            "title": "Explanation",
            "type": "string"
          },
          "item_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
            "title": "Item Id",
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "answer",
          "explanation",
          "cues"
        ],
        "title": "ImportCard",
        "type": "object"
      },
      "ImportRequest": {
        "additionalProperties": false,
        "properties": {
          "package": {
            "$ref": "#/components/schemas/PhrasePackage"
          }
        },
        "required": [
          "package"
        ],
        "title": "ImportRequest",
        "type": "object"
      },
      "ImportStatus": {
        "additionalProperties": false,
        "properties": {
          "added_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Added Count"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "package_id": {
            "title": "Package Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "preparing",
              "added",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "package_id",
          "status"
        ],
        "title": "ImportStatus",
        "type": "object"
      },
      "PhrasePackage": {
        "additionalProperties": false,
        "properties": {
          "card_language": {
            "const": "en",
            "title": "Card Language",
            "type": "string"
          },
          "cards": {
            "items": {
              "$ref": "#/components/schemas/ImportCard"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Cards",
            "type": "array"
          },
          "format": {
            "const": "phrase-gym.package",
            "title": "Format",
            "type": "string"
          },
          "help_language": {
            "const": "en",
            "title": "Help Language",
            "type": "string"
          },
          "learning_language": {
            "const": "en",
            "title": "Learning Language",
            "type": "string"
          },
          "package_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
            "title": "Package Id",
            "type": "string"
          },
          "source_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
            "title": "Source Id",
            "type": "string"
          },
          "source_label": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Source Label",
            "type": "string"
          },
          "source_link": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Link"
          },
          "version": {
            "const": 1,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "format",
          "version",
          "package_id",
          "source_id",
          "source_label",
          "learning_language",
          "card_language",
          "help_language",
          "cards"
        ],
        "title": "PhrasePackage",
        "type": "object"
      },
      "RecordingReceipt": {
        "additionalProperties": false,
        "properties": {
          "byte_length": {
            "title": "Byte Length",
            "type": "integer"
          },
          "complete": {
            "title": "Complete",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "id",
          "byte_length",
          "sha256",
          "complete"
        ],
        "title": "RecordingReceipt",
        "type": "object"
      },
      "RecordingUpload": {
        "additionalProperties": false,
        "properties": {
          "attempt_id": {
            "maxLength": 100,
            "minLength": 8,
            "title": "Attempt Id",
            "type": "string"
          },
          "audio_base64": {
            "title": "Audio Base64",
            "type": "string"
          },
          "capture_settings": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "title": "Capture Settings",
            "type": "object"
          },
          "captured_at": {
            "maxLength": 64,
            "minLength": 10,
            "title": "Captured At",
            "type": "string"
          },
          "card_id": {
            "maxLength": 100,
            "minLength": 8,
            "title": "Card Id",
            "type": "string"
          },
          "complete": {
            "title": "Complete",
            "type": "boolean"
          },
          "duration_ms": {
            "anyOf": [
              {
                "maximum": 3600000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "id": {
            "maxLength": 100,
            "minLength": 8,
            "title": "Id",
            "type": "string"
          },
          "mime_type": {
            "maxLength": 100,
            "minLength": 3,
            "title": "Mime Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "card_id",
          "attempt_id",
          "captured_at",
          "mime_type",
          "complete",
          "audio_base64"
        ],
        "title": "RecordingUpload",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Phrase Gym",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/attempts/{attempt_id}/complete": {
      "post": {
        "operationId": "complete_study_api_attempts__attempt_id__complete_post",
        "parameters": [
          {
            "in": "path",
            "name": "attempt_id",
            "required": true,
            "schema": {
              "title": "Attempt Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteStudy"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Complete Study Api Attempts  Attempt Id  Complete Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Complete Study"
      }
    },
    "/api/cards/{card_id}/reference": {
      "get": {
        "operationId": "reference_audio_api_cards__card_id__reference_get",
        "parameters": [
          {
            "in": "path",
            "name": "card_id",
            "required": true,
            "schema": {
              "title": "Card Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Reference Audio"
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/imports": {
      "post": {
        "operationId": "submit_import_api_imports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Import"
      }
    },
    "/api/imports/{package_id}": {
      "get": {
        "operationId": "import_status_api_imports__package_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "package_id",
            "required": true,
            "schema": {
              "title": "Package Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Import Status"
      }
    },
    "/api/imports/{package_id}/retry": {
      "post": {
        "operationId": "retry_import_api_imports__package_id__retry_post",
        "parameters": [
          {
            "in": "path",
            "name": "package_id",
            "required": true,
            "schema": {
              "title": "Package Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Retry Import"
      }
    },
    "/api/recordings": {
      "post": {
        "operationId": "save_recording_api_recordings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordingUpload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordingReceipt"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Save Recording"
      }
    },
    "/api/recordings/{recording_id}/audio": {
      "get": {
        "operationId": "recording_audio_api_recordings__recording_id__audio_get",
        "parameters": [
          {
            "in": "path",
            "name": "recording_id",
            "required": true,
            "schema": {
              "title": "Recording Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Recording Audio"
      }
    },
    "/api/study/current": {
      "post": {
        "operationId": "current_study_api_study_current_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Current Study Api Study Current Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Current Study"
      }
    },
    "/api/study/history": {
      "get": {
        "operationId": "study_history_api_study_history_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Study History Api Study History Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Study History"
      }
    }
  }
}
