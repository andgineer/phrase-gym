{
  "name": "phrase-gym-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.{ts,mjs}\" \"*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.{ts,mjs}\" \"*.ts\" \"*.json\""
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.18.8",
    "@vitejs/plugin-vue": "5.2.4",
    "fake-indexeddb": "6.2.5",
    "openapi-typescript": "7.10.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "4.1.11",
    "vue-tsc": "3.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
