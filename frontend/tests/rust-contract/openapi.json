{
  "openapi": "3.1.0",
  "info": {
    "title": "Phrase Gym Server",
    "description": "Rust server API during the migration",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.0.0"
  },
  "paths": {
    "/api/v1/dialogues": {
      "get": {
        "tags": [
          "library"
        ],
        "operationId": "list_dialogues",
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Language"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current dialogue revisions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DialoguePage"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dialogues/{dialogue_id}": {
      "get": {
        "tags": [
          "library"
        ],
        "operationId": "read_dialogue",
        "parameters": [
          {
            "name": "dialogue_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Language"
            }
          },
          {
            "name": "revision",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dialogue at its current or requested revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dialogue"
                }
              }
            }
          },
          "404": {
            "description": "Dialogue not found in this learning language",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exposures": {
      "post": {
        "tags": [
          "exposures"
        ],
        "operationId": "record_exposure",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExposureInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Recorded or previously recorded exposure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExposureReceipt"
                }
              }
            }
          },
          "409": {
            "description": "Exposure ID already used with a different payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Invalid payload or unknown phrase revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/lessons": {
      "get": {
        "tags": [
          "library"
        ],
        "operationId": "list_lessons",
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Language"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lessons in the learning language",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonPage"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/lessons/{lesson_id}/phrases": {
      "get": {
        "tags": [
          "library"
        ],
        "operationId": "lesson_phrases",
        "parameters": [
          {
            "name": "lesson_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Language"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lesson members in lesson order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhrasePage"
                }
              }
            }
          },
          "404": {
            "description": "Lesson not found in this learning language",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media": {
      "post": {
        "tags": [
          "media"
        ],
        "operationId": "upload_reference_media",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MediaUpload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stored or previously stored reference media",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaAsset"
                }
              }
            }
          },
          "422": {
            "description": "Invalid provenance, base64 or audio container",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media/reconcile": {
      "post": {
        "tags": [
          "media"
        ],
        "operationId": "reconcile_reference_media",
        "responses": {
          "200": {
            "description": "Missing and orphaned originals; nothing is deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reconciliation"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media/{media_id}": {
      "get": {
        "tags": [
          "media"
        ],
        "operationId": "play_reference_media",
        "parameters": [
          {
            "name": "media_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Original reference bytes"
          },
          "206": {
            "description": "Requested byte range of the original"
          },
          "404": {
            "description": "Reference media not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "416": {
            "description": "Unsatisfiable byte range"
          },
          "422": {
            "description": "Invalid identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Original is missing or damaged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media/{media_id}/metadata": {
      "get": {
        "tags": [
          "media"
        ],
        "operationId": "reference_media_metadata",
        "parameters": [
          {
            "name": "media_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reference media provenance and availability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaAsset"
                }
              }
            }
          },
          "404": {
            "description": "Reference media not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Invalid identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/phrases/search": {
      "get": {
        "tags": [
          "library"
        ],
        "operationId": "search_phrases",
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Language"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching phrases in the learning language",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhrasePage"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/phrases/{target_id}": {
      "get": {
        "tags": [
          "library"
        ],
        "operationId": "read_phrase",
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Language"
            }
          },
          {
            "name": "revision",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Phrase at its current or requested revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Phrase"
                }
              }
            }
          },
          "404": {
            "description": "Phrase or revision not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/readiness": {
      "get": {
        "tags": [
          "sessions"
        ],
        "operationId": "practice_readiness",
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Language"
            }
          },
          {
            "name": "lesson_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Due, new and preparing counts without starting a session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DueSummary"
                }
              }
            }
          },
          "404": {
            "description": "Lesson not found in this learning language",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AudioStatus": {
        "type": "string",
        "enum": [
          "ready",
          "missing"
        ]
      },
      "Chunk": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Cue": {
        "type": "object",
        "required": [
          "id",
          "prompt",
          "visible_chunks"
        ],
        "properties": {
          "audio_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "reviewed": {
            "type": "boolean",
            "default": false
          },
          "visible_chunks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "Dialogue": {
        "type": "object",
        "required": [
          "id",
          "revision",
          "language",
          "content",
          "target_ids",
          "target_revisions"
        ],
        "properties": {
          "content": {
            "$ref": "#/components/schemas/DialogueInput"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "target_ids": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "format": "uuid"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "target_revisions": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int64"
            },
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "DialogueInput": {
        "type": "object",
        "required": [
          "source_id",
          "title",
          "turns"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "turns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DialogueTurn"
            }
          }
        },
        "additionalProperties": false
      },
      "DialoguePage": {
        "type": "object",
        "required": [
          "items",
          "total",
          "offset",
          "limit"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Dialogue"
            }
          },
          "limit": {
            "type": "integer",
            "format": "int64"
          },
          "offset": {
            "type": "integer",
            "format": "int64"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "DialogueTurn": {
        "type": "object",
        "required": [
          "speaker",
          "text"
        ],
        "properties": {
          "audio_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "speaker": {
            "type": "string"
          },
          "target_source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "DueSummary": {
        "type": "object",
        "required": [
          "due_count",
          "new_count",
          "preparing_count",
          "next_due_at"
        ],
        "properties": {
          "due_count": {
            "type": "integer",
            "format": "int64"
          },
          "new_count": {
            "type": "integer",
            "format": "int64"
          },
          "next_due_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "preparing_count": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string"
          }
        }
      },
      "Explanation": {
        "type": "object",
        "required": [
          "meaning"
        ],
        "properties": {
          "breakdown": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "meaning": {
            "type": "string"
          },
          "usage": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "ExposureInput": {
        "type": "object",
        "required": [
          "id",
          "target_id",
          "revision",
          "language",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/ExposureKind"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "target_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "ExposureKind": {
        "type": "string",
        "enum": [
          "answer",
          "explanation",
          "reference"
        ]
      },
      "ExposureReceipt": {
        "type": "object",
        "required": [
          "id",
          "received_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "received_at": {
            "type": "string"
          }
        }
      },
      "Language": {
        "type": "string",
        "enum": [
          "en",
          "ru",
          "sr",
          "de"
        ]
      },
      "Lesson": {
        "type": "object",
        "required": [
          "id",
          "language",
          "title",
          "phrase_count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "phrase_count": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "LessonPage": {
        "type": "object",
        "required": [
          "items",
          "total",
          "offset",
          "limit"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Lesson"
            }
          },
          "limit": {
            "type": "integer",
            "format": "int64"
          },
          "offset": {
            "type": "integer",
            "format": "int64"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "MediaAsset": {
        "type": "object",
        "required": [
          "id",
          "sha256",
          "byte_length",
          "mime_type",
          "metadata",
          "available"
        ],
        "properties": {
          "available": {
            "type": "boolean"
          },
          "byte_length": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "metadata": {
            "$ref": "#/components/schemas/MediaMetadata"
          },
          "mime_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      },
      "MediaMetadata": {
        "type": "object",
        "required": [
          "language",
          "text",
          "role",
          "origin",
          "source",
          "locale",
          "preparation_version"
        ],
        "properties": {
          "accent": {
